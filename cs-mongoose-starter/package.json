{
  "name": "cs-mongoose-starter",
  "version": "1.0.0",
  "description": "A Node.js + TypeScript starter wired to MongoDB with Mongoose — part of the DevCraft series",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "CS Solution",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "extras": "node --env-file=.env --import tsx src/run-extras.ts",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "mongoose": "8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.9.1",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0"
  }
}
