{
  "name": "cs-graphql-custom-scalars",
  "version": "1.0.0",
  "description": "Custom scalar types in a GraphQL API with Node.js: a strict DateTime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "graphql": "16.15.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typescript": "7.0.0",
    "@graphql-codegen/typescript-resolvers": "7.0.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
