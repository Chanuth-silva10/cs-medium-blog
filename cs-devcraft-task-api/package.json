{
  "name": "cs-devcraft-task-api",
  "version": "1.0.0",
  "description": "DevCraft Task API - a project and task management REST API built with Node.js, Express and MongoDB",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "CS Solution",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.1",
    "node-cron": "4.6.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@eslint/js": "9.15.0",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.9.1",
    "@types/swagger-ui-express": "4.1.7",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.7",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0"
  }
}
