[Unit]
Description=DevCraft EMI calculator (Spring Boot)
After=network.target

[Service]
User=emi
Group=emi
WorkingDirectory=/opt/emi
# The application is always started from the same path: the "current.jar" link points to the live version.
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/emi/current.jar
# Spring Boot answers SIGTERM by finishing the requests in progress (server.shutdown=graceful).
SuccessExitStatus=143
TimeoutStopSec=40
Restart=on-failure
RestartSec=5

# Hardening: the service sees almost nothing of the server.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/emi

[Install]
WantedBy=multi-user.target
